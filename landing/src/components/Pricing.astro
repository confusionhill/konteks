---
---
<section id="pricing" class="py-24 bg-slate-900 border-t border-slate-800 text-slate-100">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    {/* Header */}
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 class="text-xs font-mono font-bold tracking-widest uppercase bg-gradient-to-r from-indigo-400 to-violet-400 bg-clip-text text-transparent">
        Predictable Pricing
      </h2>
      <h3 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        Scale your agent context, not your LLM bills.
      </h3>
      <p class="text-slate-400 text-base sm:text-lg">
        We bill strictly on local operations and processed tokens. All output tokens delivered to your agents are completely free.
      </p>
    </div>

    {/* Pricing Cards Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch mb-16">
      {/* Free Plan */}
      <div class="bg-slate-950 border border-slate-800 rounded-2xl p-8 flex flex-col justify-between hover:border-slate-700 transition-colors shadow-2xl relative overflow-hidden group">
        <div>
          <span class="text-slate-400 font-mono text-xs uppercase tracking-wider">Free</span>
          <div class="mt-4 flex items-baseline gap-1 text-white">
            <span class="text-5xl font-black tracking-tight">$0</span>
            <span class="text-sm font-semibold text-slate-500">/month</span>
          </div>
          <p class="mt-3 text-slate-400 text-sm">
            Perfect for prototyping agent memories locally.
          </p>
          <ul class="mt-8 space-y-4 text-sm text-slate-300">
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span><strong>10,000</strong> Operations</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span><strong>1M</strong> Tokens Processed</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span>1–2 Rooms per Project</span>
            </li>
            <li class="flex items-center gap-2.5 text-slate-500 line-through">
              <span>Managed Memory Routing</span>
            </li>
            <li class="flex items-center gap-2.5 text-slate-500 line-through">
              <span>Context Observability API</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a href="#quickstart" class="block w-full text-center bg-slate-800 hover:bg-slate-700 text-white text-sm font-semibold py-3 px-4 rounded-xl transition-all border border-slate-700">
            Get Started
          </a>
        </div>
      </div>

      {/* Developer Plan (Highlighted) */}
      <div class="bg-gradient-to-b from-indigo-950/40 to-slate-950 border-2 border-indigo-500 rounded-2xl p-8 flex flex-col justify-between hover:border-indigo-400 transition-colors shadow-2xl relative overflow-hidden group">
        <div class="absolute top-0 right-0 bg-indigo-500 text-white font-mono text-[9px] font-bold uppercase tracking-widest py-1.5 px-4 rounded-bl-xl shadow-md">
          Most Popular
        </div>
        <div>
          <span class="text-indigo-400 font-mono text-xs uppercase tracking-wider font-semibold">Developer</span>
          <div class="mt-4 flex items-baseline gap-1 text-white">
            <span class="text-5xl font-black tracking-tight">$29</span>
            <span class="text-sm font-semibold text-slate-500">/month</span>
          </div>
          <p class="mt-3 text-slate-400 text-sm">
            For production-grade context workloads and active chat agents.
          </p>
          <ul class="mt-8 space-y-4 text-sm text-slate-300">
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span><strong>100,000</strong> Operations</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span><strong>10M</strong> Tokens Processed</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span>Unlimited Rooms</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span>Context Analytics & Observability</span>
            </li>
            <li class="flex items-center gap-2.5 text-slate-500 line-through">
              <span>Multi-provider Memory Routing</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a href="#quickstart" class="block w-full text-center bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold py-3 px-4 rounded-xl transition-all shadow-lg hover:shadow-indigo-500/20">
            Start Free Trial
          </a>
        </div>
      </div>

      {/* Pro Plan */}
      <div class="bg-slate-950 border border-slate-800 rounded-2xl p-8 flex flex-col justify-between hover:border-slate-700 transition-colors shadow-2xl relative overflow-hidden group">
        <div>
          <span class="text-slate-400 font-mono text-xs uppercase tracking-wider">Pro</span>
          <div class="mt-4 flex items-baseline gap-1 text-white">
            <span class="text-5xl font-black tracking-tight">$99</span>
            <span class="text-sm font-semibold text-slate-500">/month</span>
          </div>
          <p class="mt-3 text-slate-400 text-sm">
            For scaling commercial agents requiring heavy token throughput.
          </p>
          <ul class="mt-8 space-y-4 text-sm text-slate-300">
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span><strong>1,000,000</strong> Operations</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span><strong>100M</strong> Tokens Processed</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span>Advanced Analytics Dashboard</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span>Multi-provider Memory Routing</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
              <span>Priority Support (Slack / Email)</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a href="#quickstart" class="block w-full text-center bg-slate-800 hover:bg-slate-700 text-white text-sm font-semibold py-3 px-4 rounded-xl transition-all border border-slate-700">
            Get Pro
          </a>
        </div>
      </div>
    </div>

    {/* Enterprise Section */}
    <div class="bg-gradient-to-r from-slate-950 to-indigo-950/20 border border-slate-800 rounded-2xl p-8 sm:p-10 flex flex-col md:flex-row md:items-center justify-between gap-6 shadow-2xl">
      <div class="space-y-2 max-w-2xl">
        <span class="inline-block bg-indigo-500/10 text-indigo-400 text-[10px] font-bold font-mono px-2.5 py-1 rounded-full uppercase tracking-wider border border-indigo-500/20">
          Enterprise
        </span>
        <h4 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Need dedicated scale or self-hosted context?</h4>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          Custom SLA, SCIM / SSO, private vector database VPCs, data residency boundaries, and customer-managed encryption keys.
        </p>
      </div>
      <div class="shrink-0">
        <a href="mailto:sales@contextkit.com" class="inline-block bg-white hover:bg-slate-100 text-slate-900 text-sm font-bold py-3 px-6 rounded-xl transition-all shadow-md">
          Contact Sales
        </a>
      </div>
    </div>
  </div>
</section>
