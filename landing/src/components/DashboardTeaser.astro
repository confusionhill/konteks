---
---

<section id="dashboard" class="py-20 md:py-28 bg-[#F8FAFC]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-indigo-200"></span>
        <span class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-indigo-600">Developer dashboard</span>
        <span class="h-px w-8 bg-indigo-200"></span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        See exactly what your agent sees
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Every turn is inspectable: what context went out, how relevant it was, and what
        resolved. Debugging without guesswork.
      </p>
    </div>

    <!-- Dashboard UI Mockup Card -->
    <div class="max-w-5xl mx-auto rounded-2xl bg-white border border-slate-200/80 shadow-soft-indigo overflow-hidden">
      <!-- Top bar -->
      <div class="px-6 py-4 bg-slate-50 border-b border-slate-200/80 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 rounded-full bg-indigo-600"></span>
          <span class="font-mono text-xs font-bold text-slate-700">Room Inspector / room_hotel_982</span>
        </div>
        <span class="text-xs font-mono px-2 py-1 rounded bg-emerald-50 text-emerald-600 font-semibold border border-emerald-200/60">
          active
        </span>
      </div>

      <!-- Dashboard Grid -->
      <div class="p-6 md:p-8 grid md:grid-cols-3 gap-6 font-mono text-xs">
        <!-- Room Inspector -->
        <div class="p-4 rounded-lg bg-slate-50 border border-slate-200/80 space-y-3">
          <span class="text-slate-500 font-bold block text-[11px] uppercase tracking-wider">Active room state</span>
          <div class="text-slate-800 space-y-1">
            <p><span class="text-indigo-600 font-semibold">topic:</span> "Bali hotel booking"</p>
            <p><span class="text-indigo-600 font-semibold">location:</span> "Kuta, Bali"</p>
            <p><span class="text-indigo-600 font-semibold">budget:</span> ≤ $150/night</p>
            <p><span class="text-indigo-600 font-semibold">amenities:</span> ["pool", "wifi"]</p>
            <p><span class="text-indigo-600 font-semibold">check_in:</span> Friday, 3 PM</p>
          </div>
        </div>

        <!-- Context Quality -->
        <div class="p-4 rounded-lg bg-slate-50 border border-slate-200/80 space-y-3">
          <span class="text-slate-500 font-bold block text-[11px] uppercase tracking-wider">Context quality</span>
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-slate-600">Relevance</span>
              <span class="text-indigo-600 font-bold">0.94</span>
            </div>
            <div class="w-full h-1.5 rounded-full bg-slate-200 overflow-hidden">
              <div class="h-full bg-indigo-500 rounded-full w-[94%]"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-slate-600">Completeness</span>
              <span class="text-indigo-600 font-bold">0.91</span>
            </div>
            <div class="w-full h-1.5 rounded-full bg-slate-200 overflow-hidden">
              <div class="h-full bg-violet-500 rounded-full w-[91%]"></div>
            </div>
          </div>
          <p class="text-[11px] text-slate-500 pt-1 leading-relaxed">
            This turn got summary + state + 2 relevant messages. Nothing else.
          </p>
        </div>

        <!-- Event Timeline -->
        <div class="p-4 rounded-lg bg-slate-50 border border-slate-200/80 space-y-3">
          <span class="text-slate-500 font-bold block text-[11px] uppercase tracking-wider">Live event stream</span>
          <div class="space-y-1.5 text-[11px]">
            <p class="text-indigo-600">18:22:04 user.message "Does it have a pool?"</p>
            <p class="text-violet-600">18:22:04 entity.resolved "it" → Grand Hyatt</p>
            <p class="text-emerald-600">18:22:05 context.delivered summary + state</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>