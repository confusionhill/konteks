---
import HeroPreview from "./HeroPreview";
import RotatingWord from "./RotatingWord";
---

<section class="relative pt-14 pb-20 md:pt-20 md:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Hero Left Text Column -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <!-- Top Pill Badge -->
        <div class="inline-flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
          <span
            class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-indigo-600"
            >Context Management as a Service</span
          >
        </div>

        <!-- Main H1 Headline -->
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.06]"
        >
          You build the <RotatingWord client:load />. <br
            class="hidden sm:inline"
          />
          <span
            class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent"
          >
            We handle its context.
          </span>
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-2xl">
          Switch models, switch frameworks,           switch your frontend. The
          conversation keeps going. Nobody has to start over.
        </p>

        <!-- CTA Action Buttons -->
        <div
          class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4"
        >
          <a
            href="mailto:hello@contextkit.com"
            class="inline-flex items-center justify-center text-base font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 px-6 py-3.5 rounded-xl shadow-btn-indigo hover:-translate-y-0.5 transition-all duration-200 group"
          >
            Join the waitlist
            <svg
              class="ml-2 w-5 h-5 transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center justify-center text-base font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200/80 px-6 py-3.5 rounded-xl transition-colors"
          >
            See how it works
          </a>
        </div>

        <!-- Trust points -->
        <div
          class="pt-4 flex flex-wrap items-center gap-y-2 gap-x-6 text-sm text-slate-500"
        >
          <span class="flex items-center gap-2">
            <svg
              class="w-4 h-4 text-emerald-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path></svg
            >
            Works with OpenAI, Claude, Gemini, or local models
          </span>
          <span class="flex items-center gap-2">
            <svg
              class="w-4 h-4 text-emerald-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path></svg
            >
            No lock-in. Keep your agent, tools, and data
          </span>
          <span class="flex items-center gap-2">
            <svg
              class="w-4 h-4 text-emerald-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path></svg
            >
            Simple REST API. Integrate in minutes
          </span>
        </div>
      </div>

      <!-- Hero Right Preview Graphic -->
      <div class="lg:col-span-5 relative">
        <div class="relative z-10">
          <HeroPreview client:load />
        </div>
      </div>
    </div>
  </div>
</section>
