---
---

<section id="dashboard" class="py-20 md:py-28 bg-[#F8FAFC]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-violet-600 px-3 py-1 rounded-full bg-violet-50 border border-violet-200/60">
        Developer Dashboard & Observability
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Complete visibility into your agent's context
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Inspect room states, audit context token savings, and debug real-time streaming events from a sleek developer dashboard.
      </p>
    </div>

    <!-- Dev Dashboard UI Mockup Card -->
    <div class="max-w-5xl mx-auto rounded-xl bg-white border border-slate-200/80 shadow-soft-indigo overflow-hidden">
      <!-- Top bar -->
      <div class="px-6 py-4 bg-slate-50 border-b border-slate-200/80 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 rounded-full bg-indigo-600"></span>
          <span class="font-mono text-xs font-bold text-slate-700">Konteks Dashboard / Room Inspector</span>
        </div>
        <span class="text-xs font-mono px-2 py-1 rounded bg-emerald-50 text-emerald-600 font-semibold border border-emerald-200/60">
          ● Engine Active
        </span>
      </div>

      <!-- Dashboard Grid -->
      <div class="p-6 md:p-8 grid md:grid-cols-3 gap-6 font-mono text-xs">
        <!-- Room Inspector -->
        <div class="p-4 rounded-lg bg-slate-50 border border-slate-200/80 space-y-3">
          <span class="text-slate-500 font-bold block text-[11px] uppercase tracking-wider">Active Room State</span>
          <div class="text-slate-800 space-y-1">
            <p><span class="text-indigo-600 font-semibold">room_id:</span> "room_hotel_982"</p>
            <p><span class="text-indigo-600 font-semibold">topic:</span> "Bali Hotel Search"</p>
            <p><span class="text-indigo-600 font-semibold">location:</span> "Kuta, Bali"</p>
            <p><span class="text-indigo-600 font-semibold">max_budget:</span> $150/night</p>
            <p><span class="text-indigo-600 font-semibold">amenities:</span> ["pool", "wifi"]</p>
          </div>
        </div>

        <!-- Token Savings Gauge -->
        <div class="p-4 rounded-lg bg-slate-50 border border-slate-200/80 space-y-3">
          <span class="text-slate-500 font-bold block text-[11px] uppercase tracking-wider">Token Efficiency</span>
          <div class="space-y-2">
            <div class="flex justify-between">
              <span class="text-slate-600">Raw Chat History:</span>
              <span class="text-red-500 font-bold">4,280 tokens</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-600">Konteks Payload:</span>
              <span class="text-emerald-600 font-bold">142 tokens</span>
            </div>
            <div class="w-full h-2 rounded-full bg-slate-200 overflow-hidden">
              <div class="h-full bg-emerald-500 rounded-full w-[96.7%]"></div>
            </div>
            <p class="text-[11px] text-emerald-600 font-semibold pt-1">96.7% Token Reduction per turn</p>
          </div>
        </div>

        <!-- Event Timeline -->
        <div class="p-4 rounded-lg bg-slate-50 border border-slate-200/80 space-y-3">
          <span class="text-slate-500 font-bold block text-[11px] uppercase tracking-wider">Real-Time Event Stream</span>
          <div class="space-y-1.5 text-[11px]">
            <p class="text-indigo-600">18:22:04 [user.message] "Does it have a pool?"</p>
            <p class="text-violet-600">18:22:04 [entity.resolved] pronoun "it" → hotel_123</p>
            <p class="text-emerald-600">18:22:05 [context.delivered] 142 tokens (18ms)</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
