---
const facts = ['Multi-agent teams', 'Flags stale facts', 'Core memory files', 'Team workspaces', 'MCP-native'];
---

<section class="bg-white border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-12">
    <p class="text-center text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 mb-5">
      &nbsp;·&nbsp; Also built in &nbsp;·&nbsp;
    </p>
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
      {facts.map((fact, i) => (
        <span class="inline-flex items-baseline gap-2 text-sm leading-none">
          <span class="font-mono text-[11px] font-bold text-indigo-500">0{i + 1}</span>
          <span class="font-semibold text-slate-700 transition-colors hover:text-indigo-600">{fact}</span>
          {i < facts.length - 1 && (
            <svg class="w-3 h-3 text-slate-300 mx-1 self-center" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M14 4l-4 16" />
            </svg>
          )}
        </span>
      ))}
    </div>
  </div>
</section>