---
---

<section id="how-it-works" class="py-20 md:py-28 bg-white border-t border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-indigo-200"></span>
        <span class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-indigo-600">How it works</span>
        <span class="h-px w-8 bg-indigo-200"></span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        One conversation, three steps.
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Your reasoning, your tools, your model. Konteks just keeps the conversation.
        Nothing else changes in your stack.
      </p>
    </div>

    <!-- 3 Steps -->
    <div class="grid lg:grid-cols-3 gap-8">

      <!-- Step 1 -->
      <div class="relative bg-slate-50 p-8 rounded-xl border border-slate-200/80 space-y-4">
        <div class="w-10 h-10 rounded-lg bg-indigo-600 text-white font-extrabold text-lg flex items-center justify-center shadow-md shadow-indigo-500/20">
          1
        </div>
        <h3 class="text-xl font-bold text-slate-900">Save the message</h3>
        <p class="text-slate-600 text-sm leading-relaxed">
          Every message a user sends is stored in its room, in order, with everything else
          in that conversation.
        </p>
        <div class="p-3 bg-slate-900 rounded-lg text-slate-200 font-mono text-xs overflow-x-auto">
          POST /v1/rooms/room_123/messages
        </div>
      </div>

      <!-- Step 2 -->
      <div class="relative bg-slate-50 p-8 rounded-xl border border-slate-200/80 space-y-4">
        <div class="w-10 h-10 rounded-lg bg-violet-600 text-white font-extrabold text-lg flex items-center justify-center shadow-md shadow-violet-500/20">
          2
        </div>
        <h3 class="text-xl font-bold text-slate-900">Get the context</h3>
        <p class="text-slate-600 text-sm leading-relaxed">
          Konteks pulls together what this reply needs as one clean package: what was said,
          what's decided, what matters.
        </p>
        <div class="p-3 bg-slate-900 rounded-lg text-slate-200 font-mono text-xs overflow-x-auto">
          POST /v1/rooms/room_123/context
        </div>
      </div>

      <!-- Step 3 -->
      <div class="relative bg-slate-50 p-8 rounded-xl border border-slate-200/80 space-y-4">
        <div class="w-10 h-10 rounded-lg bg-indigo-600 text-white font-extrabold text-lg flex items-center justify-center shadow-md shadow-indigo-500/20">
          3
        </div>
        <h3 class="text-xl font-bold text-slate-900">Run your agent</h3>
        <p class="text-slate-600 text-sm leading-relaxed">
          Send the package into your model or framework. Your reasoning stays with you.
          We just hand off the memory.
        </p>
        <div class="p-3 bg-slate-900 rounded-lg text-emerald-400 font-mono text-xs overflow-x-auto">
          llm.generate(prompt=context)
        </div>
      </div>

    </div>

  </div>
</section>