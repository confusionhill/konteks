---
---

<section id="features" class="py-20 md:py-28 bg-[#F8FAFC]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200/60">
        Features
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Built to make your AI agents feel human
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Everything you need to deliver stateful, intelligent agent experiences without building memory infrastructure from scratch.
      </p>
    </div>

    <!-- Bento Grid Cards -->
    <div class="grid md:grid-cols-2 gap-8">
      
      <!-- Flagship E2EE Feature Card (Full Width) -->
      <div class="md:col-span-2 bg-gradient-to-r from-slate-900 to-indigo-950 p-8 rounded-xl border border-indigo-500/30 text-white shadow-xl hover:-translate-y-0.5 transition-all duration-200 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative overflow-hidden group">
        <div class="space-y-3 max-w-2xl z-10">
          <div class="flex items-center gap-2">
            <span class="w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-300 flex items-center justify-center font-bold text-base">🔐</span>
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-400 bg-indigo-950/80 px-2.5 py-1 rounded border border-indigo-500/30">Optional Module • Paid Tiers</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white">Zero-Trust E2EE & Encrypted Vector Search</h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            Encrypt message payloads with AES-256-GCM envelope encryption and perform distance-preserving vector search using orthonormal matrix rotation (<code class="text-indigo-300 bg-slate-800 px-1 py-0.5 rounded font-mono">R · v</code>). Konteks operates as a 100% Zero-Knowledge platform.
          </p>
        </div>
        <div class="shrink-0 z-10">
          <a href="#security-e2ee" class="inline-flex items-center gap-2 text-xs font-mono font-bold text-white bg-indigo-600 hover:bg-indigo-500 px-4 py-2.5 rounded-lg transition-colors shadow-md">
            Learn Security Architecture &rarr;
          </a>
        </div>
      </div>
      
      <!-- Feature 1 -->
      <div class="bg-white p-8 rounded-xl border border-slate-200/80 shadow-soft-indigo hover:shadow-soft-indigo-hover hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-lg">
            🏠
          </div>
          <h3 class="text-2xl font-bold text-slate-900">Stateful Conversation Rooms</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Every chat session gets its own isolated, persistent container. Konteks tracks raw messages, active topics, user preferences, and temporal state in one place.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-mono text-indigo-600 font-semibold">
          ✓ Room-first persistent abstraction
        </div>
      </div>

      <!-- Feature 2 -->
      <div class="bg-white p-8 rounded-xl border border-slate-200/80 shadow-soft-indigo hover:shadow-soft-indigo-hover hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-violet-100 text-violet-600 flex items-center justify-center font-bold text-lg">
            🔗
          </div>
          <h3 class="text-2xl font-bold text-slate-900">Smart Reference Linking</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Automatically resolves ambiguous pronouns like <em>"it"</em>, <em>"that option"</em>, or <em>"the cheaper one"</em> to the exact item ID discussed previously.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-mono text-violet-600 font-semibold">
          ✓ Native entity & pronoun resolution
        </div>
      </div>

      <!-- Feature 3 -->
      <div class="bg-white p-8 rounded-xl border border-slate-200/80 shadow-soft-indigo hover:shadow-soft-indigo-hover hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-lg">
            🧹
          </div>
          <h3 class="text-2xl font-bold text-slate-900">Automatic Chat Compaction</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Background workers continuously summarize long-running conversations into concise summaries so your context window never overflows.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-mono text-indigo-600 font-semibold">
          ✓ Async background summarizer
        </div>
      </div>

      <!-- Feature 4 -->
      <div class="bg-white p-8 rounded-xl border border-slate-200/80 shadow-soft-indigo hover:shadow-soft-indigo-hover hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-lg">
            🔓
          </div>
          <h3 class="text-2xl font-bold text-slate-900">Zero Lock-In Architecture</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Bring Your Own Agent (BYOA) and Bring Your Own Data (BYOD). Works with LangGraph, LlamaIndex, custom Python scripts, or Go apps seamlessly.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-mono text-emerald-600 font-semibold">
          ✓ Model & Agent framework agnostic
        </div>
      </div>

    </div>

  </div>
</section>
