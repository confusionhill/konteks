---
---

<section id="security-e2ee" class="py-20 md:py-28 bg-slate-950 text-white relative overflow-hidden border-t border-slate-800">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-80 bg-gradient-to-b from-indigo-600/10 to-transparent blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 items-center">

      <div class="lg:col-span-5 space-y-5">
        <span class="inline-flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
          <span class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-indigo-300">Private by default</span>
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
          Your conversations are yours.
        </h2>
        <p class="text-slate-400 text-base leading-relaxed">
          Conversation data is sensitive. We treat it that way, with strong encryption and
          a clear hands-off policy, no matter your plan.
        </p>
      </div>

      <div class="lg:col-span-7">
        <div class="grid sm:grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-slate-900/80 p-6 rounded-2xl border border-slate-800/80 hover:border-indigo-500/40 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
            </div>
            <h3 class="font-bold text-white mb-1.5">Encrypted at rest and in transit</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Every message is encrypted the moment it's stored and on the way in and out.</p>
          </div>

          <div class="bg-slate-900/80 p-6 rounded-2xl border border-slate-800/80 hover:border-violet-500/40 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-violet-500/10 border border-violet-500/20 text-violet-400 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-2-8 2v7c0 6 8 10 8 10z" />
              </svg>
            </div>
            <h3 class="font-bold text-white mb-1.5">E2EE for zero-trust teams</h3>
            <p class="text-slate-400 text-sm leading-relaxed">An optional module where not even we can read your data. Available on paid tiers.</p>
          </div>

          <div class="bg-slate-900/80 p-6 rounded-2xl border border-slate-800/80 hover:border-emerald-500/40 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l2.9 5.9 6.5 1-4.7 4.6 1.1 6.5L12 17l-5.8 3 1.1-6.5L2.6 8.9l6.5-1L12 2z" />
              </svg>
            </div>
            <h3 class="font-bold text-white mb-1.5">Never trained on, never sold</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Your data isn't used to train models and is never shared with anyone.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>