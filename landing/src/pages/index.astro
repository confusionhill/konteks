---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import FactStrip from '../components/FactStrip.astro';
import Metrics from '../components/Metrics.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import Architecture from '../components/Architecture.astro';
import BentoGrid from '../components/BentoGrid.astro';
import SecurityE2EE from '../components/SecurityE2EE.astro';
import QuickStart from '../components/QuickStart';
import DashboardTeaser from '../components/DashboardTeaser.astro';
import Pricing from '../components/Pricing.astro';
import ComingSoon from '../components/ComingSoon.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

const showPricing = false;
---

<Layout title="Konteks — You build the agent. We handle its context.">
  <Navbar />
  <main>
    <Hero />
    <FactStrip />
    <Metrics />
    <ProblemSolution />
    <Architecture />
    <BentoGrid />
    <SecurityE2EE />
    <QuickStart client:visible />
    <DashboardTeaser />
    {showPricing && <Pricing />}
    {!showPricing && <ComingSoon />}
    <CTA />
  </main>
  <Footer />
</Layout>
